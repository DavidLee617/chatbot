<?xml version="1.0" encoding="UTF-8"?>
<!--
  C# 对照：pom.xml ≈ .csproj
  - <parent> 继承 Spring Boot 的版本管理，类似 Directory.Packages.props（中央包版本管理）
  - <dependencies> ≈ <PackageReference>，Maven Central ≈ NuGet
  - mvn package ≈ dotnet publish；产物是一个可执行 jar
  版本与 pr-reviewer 保持一致：Spring Boot 3.5.16 + Spring AI 1.1.8
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.lee</groupId>
    <artifactId>psyqa</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>psyqa</name>
    <description>心理学经典问答机器人（RAG）</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <!-- 默认跳过需要外部服务（百炼 / Milvus）的测试；mvn test -Pintegration 单独跑 -->
        <test.excludedGroups>integration</test.excludedGroups>
        <test.groups></test.groups>
    </properties>

    <dependencies>
        <!-- 百炼走 OpenAI 兼容接口：chat + embedding 都用这个 starter -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- 代码只依赖 VectorStore 接口；换 PGVector / ES 只需换这个依赖 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
        </dependency>
        <!-- SSE 流式接口（≈ ASP.NET Core 里返回 IAsyncEnumerable） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- macOS 上 netty 的 DNS 原生库，否则启动时报一条 MacOSDnsServerAddressStreamProvider 的 ERROR -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-resolver-dns-native-macos</artifactId>
            <classifier>osx-aarch_64</classifier>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <finalName>psyqa</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                    <groups>${test.groups}</groups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration</id>
            <properties>
                <test.excludedGroups></test.excludedGroups>
                <test.groups>integration</test.groups>
            </properties>
        </profile>
    </profiles>
</project>
